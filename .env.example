# 바이낸스 선물 웹소켓 base URL
BINANCE_WS_BASE_URL=wss://fstream.binance.com/market

# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BIT_RECON_BOT_TOKEN=your_telegram_bot_token

# 거래량 알림을 보낼 텔레그램 채널/채팅 ID
TELEGRAM_BIT_RECON_BOT_CHAT_ID_VOLUME=your_volume_channel_chat_id

# 가격 알림을 보낼 텔레그램 채널/채팅 ID
TELEGRAM_BIT_RECON_BOT_CHAT_ID_PRICE=your_price_channel_chat_id

# 봉 갱신 알림을 보낼 텔레그램 채널/채팅 ID
TELEGRAM_BIT_RECON_BOT_CHAT_ID_CANDLE=your_candle_channel_chat_id
